# Absolute path or command name for TwitchDownloaderCLI
TWITCH_DOWNLOADER=TwitchDownloaderCLI
# Python inside the project virtual environment created by bootstrap-linux.sh
PYTHON_BIN=.venv/bin/python
# Installed locally by bootstrap-linux.sh when system FFmpeg is absent.
FFMPEG_BIN=.tools/ffmpeg/ffmpeg
